\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Depth-aware Kusama-style polka dot rendering of a pumpkin image (black\_red palette, $\alpha =1.5$, $\sigma =0.15$, $r_{\max }=14$\,px). Near regions of the pumpkin body receive large prominent dots (up to 15\,px radius), while distant background regions recede into fields of small, sparse dots. The horror-vacui background fill ensures no canvas region is empty.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:result_pumpkin}{{2}{6}{Depth-aware Kusama-style polka dot rendering of a pumpkin image (black\_red palette, $\alpha =1.5$, $\sigma =0.15$, $r_{\max }=14$\,px). Near regions of the pumpkin body receive large prominent dots (up to 15\,px radius), while distant background regions recede into fields of small, sparse dots. The horror-vacui background fill ensures no canvas region is empty}{figure.caption.7}{}}
