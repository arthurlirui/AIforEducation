\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Depth-to-radius mapping (Eq.~\ref {eq:radius_mapping}). (a)~Expected radius vs.\ normalized depth for $\alpha \in \{0.5, 1.0, 1.5, 2.5\}$, $\sigma = 0$. Larger $\alpha $ yields a steeper, convex falloff. (b)~Mean mapping at $\alpha = 1.5$ together with the $\pm 3\sigma $ envelope for $\sigma \in \{0.10, 0.15, 0.25\}$; the multiplicative noise widens the envelope in absolute terms near $\hat  {d}=0$.}}{7}{figure.caption.14}\protected@file@percent }
\newlabel{fig:radius_mapping}{{4}{7}{Depth-to-radius mapping (Eq.~\ref {eq:radius_mapping}). (a)~Expected radius vs.\ normalized depth for $\alpha \in \{0.5, 1.0, 1.5, 2.5\}$, $\sigma = 0$. Larger $\alpha $ yields a steeper, convex falloff. (b)~Mean mapping at $\alpha = 1.5$ together with the $\pm 3\sigma $ envelope for $\sigma \in \{0.10, 0.15, 0.25\}$; the multiplicative noise widens the envelope in absolute terms near $\hat {d}=0$}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Radius field $r(x,y)$ induced by the normalized pumpkin depth map. (a)~Input $\hat  {d}(x,y)$ (inferno, bright = near). (b--d)~Radius fields for $\alpha \in \{0.5, 1.5, 2.5\}$, $\sigma = 0$ (viridis, bright = large radius). Increasing $\alpha $ concentrates the largest dots on the front of the pumpkin body while shrinking the rear and background.}}{7}{figure.caption.15}\protected@file@percent }
\newlabel{fig:radius_field}{{5}{7}{Radius field $r(x,y)$ induced by the normalized pumpkin depth map. (a)~Input $\hat {d}(x,y)$ (inferno, bright = near). (b--d)~Radius fields for $\alpha \in \{0.5, 1.5, 2.5\}$, $\sigma = 0$ (viridis, bright = large radius). Increasing $\alpha $ concentrates the largest dots on the front of the pumpkin body while shrinking the rear and background}{figure.caption.15}{}}
