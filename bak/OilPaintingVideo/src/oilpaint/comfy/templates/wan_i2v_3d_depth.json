{
  "_comment": "Wan2.1 I2V 工作流（3D 白膜驱动 + 风格稳定）。API 格式。节点 id 约定见 mesh2video/pipeline.py 的 inject_* 函数。需要 ComfyUI 已安装 ComfyUI-WanVideoWrapper（Kijai）节点 + wan2.1-i2v 模型 + wan2.1-1.3b-control-lora-depth 控制权重 + VHS_VideoCombine。流程：风格参考图(CLIP vision + I2V 编码) + 深度图序列(控制 LoRA 编码) → WanVideoSampler → 解码 → mp4。",
  "input_style_image": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "style_ref.png"
    }
  },
  "input_depth_video": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "depth_seq.mp4",
      "force_rate": 0,
      "frame_load_cap": 49,
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "wan_model": {
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model_name": "wan2.1_i2v_480p_bf16.safetensors",
      "quantization": "disabled",
      "load_device": "offload"
    }
  },
  "wan_t5": {
    "class_type": "LoadWanVideoT5TextEncoder",
    "inputs": {
      "model_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "model_offload": true
    }
  },
  "wan_vae": {
    "class_type": "WanVideoVAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "wan_clip_vision": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "open_clip_pytorch_model.safetensors"
    }
  },
  "wan_control_lora": {
    "class_type": "WanVideoLoraSelect",
    "inputs": {
      "lora_name": "wan2.1-1.3b-control-lora-depth-v0.1_comfy.safetensors",
      "strength": 1.0,
      "normalize_weights": false
    }
  },
  "wan_pos_text": {
    "class_type": "WanVideoTextEncode",
    "inputs": {
      "text": "oil painting, impasto brush strokes, cinematic lighting, masterpiece",
      "t5": ["wan_t5", 0],
      "use_cfg_rescale": false
    }
  },
  "wan_neg_text": {
    "class_type": "WanVideoTextEncode",
    "inputs": {
      "text": "static, 3d render, flat shading, low quality, jitter, watermark, text, blurry",
      "t5": ["wan_t5", 0],
      "use_cfg_rescale": false
    }
  },
  "wan_clip_encode": {
    "class_type": "WanVideoCLIPVisionEncode",
    "inputs": {
      "clip_vision": ["wan_clip_vision", 0],
      "image": ["input_style_image", 0]
    }
  },
  "wan_i2v_encode": {
    "class_type": "WanVideoImageToVideoEncode",
    "inputs": {
      "vae": ["wan_vae", 0],
      "image": ["input_style_image", 0],
      "width": 832,
      "height": 480,
      "num_frames": 49,
      "strength": 0.9,
      "enable_vae_tiling": true,
      "tile_size": 256,
      "tile_overlap": 32
    }
  },
  "wan_depth_encode": {
    "class_type": "WanVideoEncode",
    "inputs": {
      "vae": ["wan_vae", 0],
      "image": ["input_depth_video", 0],
      "strength": 1.0,
      "start_percent": 0.0,
      "enable_vae_tiling": true
    }
  },
  "wan_depth_control": {
    "class_type": "WanVideoControlEmbeds",
    "inputs": {
      "latents": ["wan_depth_encode", 0],
      "start_percent": 0.0,
      "strength": 0.7
    }
  },
  "wan_block_swap": {
    "class_type": "WanVideoBlockSwap",
    "inputs": {
      "blocks_to_swap": 20,
      "enable_output_offload": true
    }
  },
  "wan_teacache": {
    "class_type": "WanVideoTeaCache",
    "inputs": {
      "rel_l1_thresh": 0.1,
      "start_step": 0,
      "end_step": 100,
      "use_fast_mode": "true",
      "coeffs_type": "e"
    }
  },
  "wan_context": {
    "class_type": "WanVideoContextOptions",
    "inputs": {
      "context_frames": 81,
      "context_overlap": 16,
      "context_schedule": "uniform_standard"
    }
  },
  "wan_sampler": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": ["wan_model", 0],
      "text_embeds": ["wan_pos_text", 0],
      "negative_embeds": ["wan_neg_text", 0],
      "image_embeds": ["wan_i2v_encode", 0],
      "latents": ["wan_depth_control", 0],
      "steps": 30,
      "cfg": 6.0,
      "shift": 8.0,
      "scheduler": "unipc",
      "seed": 0,
      "control_lora": ["wan_control_lora", 0],
      "clip_vision": ["wan_clip_encode", 0],
      "teacache": ["wan_teacache", 0],
      "context_options": ["wan_context", 0],
      "block_swap": ["wan_block_swap", 0]
    }
  },
  "wan_decode": {
    "class_type": "WanVideoDecode",
    "inputs": {
      "vae": ["wan_vae", 0],
      "samples": ["wan_sampler", 0],
      "enable_vae_tiling": true,
      "tile_x": 480,
      "tile_y": 256
    }
  },
  "wan_save": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["wan_decode", 0],
      "filename_prefix": "mesh2video_wan",
      "frame_rate": 24,
      "format": "video/h264-mp4",
      "save_metadata": false
    }
  }
}
