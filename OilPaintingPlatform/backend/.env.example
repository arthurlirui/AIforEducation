# Copy this file to `.env` and fill in the keys you have.
# The platform runs without any key (uses the mock provider) for demos.

# Default image-generation provider: mock | openai | dashscope | zhipu | sdwebui
DEFAULT_PROVIDER=mock

# ---- OpenAI DALL·E ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=dall-e-3

# ---- 阿里云通义万相 (DashScope) ----
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=wanx-v1

# ---- 智谱 CogView ----
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_IMAGE_MODEL=cogview-3-plus

# ---- Stable Diffusion WebUI (Automatic1111) ----
SDWEBUI_BASE_URL=http://127.0.0.1:7860
SDWEBUI_SAMPLER=DPM++ 2M Karras
SDWEBUI_STEPS=30

# ---- Generation defaults ----
DEFAULT_SIZE=1024x1024
REQUEST_TIMEOUT=120
