\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Canvas3D overview.} A modular pipeline that factors painting animation into four independently optimized specialists: \emph  {PaintParse} (perceptual grouping and depth-ordered layering), \emph  {MonoSplat} (per-object 3D lifting into a reusable library), \emph  {SketchComp} (line-art-guided scene composition with depth-aware inpainting), and \emph  {ArtiFlow} (geometry-grounded video synthesis with dual control signals). A dashed feedback loop re-composes the scene when per-object motion verification fails.}}{12}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{12}{\textbf {Canvas3D overview.} A modular pipeline that factors painting animation into four independently optimized specialists: \emph {PaintParse} (perceptual grouping and depth-ordered layering), \emph {MonoSplat} (per-object 3D lifting into a reusable library), \emph {SketchComp} (line-art-guided scene composition with depth-aware inpainting), and \emph {ArtiFlow} (geometry-grounded video synthesis with dual control signals). A dashed feedback loop re-composes the scene when per-object motion verification fails}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {PaintParse.} A segmentation backbone and a monocular depth estimator run in parallel; art-domain adaptation injects painting-specific statistics into the backbone, and a percentile-based layer assignment fuses masks with depth into a depth-ordered output.}}{12}{figure.caption.8}\protected@file@percent }
\newlabel{fig:paintparse}{{2}{12}{\textbf {PaintParse.} A segmentation backbone and a monocular depth estimator run in parallel; art-domain adaptation injects painting-specific statistics into the backbone, and a percentile-based layer assignment fuses masks with depth into a depth-ordered output}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {MonoSplat.} Each foreground crop is lifted into a canonical 3D representation by a feed-forward predictor; the PaintParse depth cue is used to recover metric scale, and the resulting objects are stored in a reusable, retrievable library.}}{12}{figure.caption.12}\protected@file@percent }
\newlabel{fig:monosplat}{{3}{12}{\textbf {MonoSplat.} Each foreground crop is lifted into a canonical 3D representation by a feed-forward predictor; the PaintParse depth cue is used to recover metric scale, and the resulting objects are stored in a reusable, retrievable library}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {SketchComp.} Hand-drawn contours are extracted and matched to rendered 3D silhouettes via a rigid registration that jointly optimizes region IoU and boundary Chamfer distance. After depth-sorted scene assembly, disocclusion gaps are detected and filled by a depth-conditioned inpainting diffusion module that respects the background's geometric structure.}}{12}{figure.caption.16}\protected@file@percent }
\newlabel{fig:sketchcomp}{{4}{12}{\textbf {SketchComp.} Hand-drawn contours are extracted and matched to rendered 3D silhouettes via a rigid registration that jointly optimizes region IoU and boundary Chamfer distance. After depth-sorted scene assembly, disocclusion gaps are detected and filled by a depth-conditioned inpainting diffusion module that respects the background's geometric structure}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {ArtiFlow.} The composited 3D scene is rendered into a multi-view keyframe stream providing RGB, depth, and edge signals. A dual-branch control injection (depth + edge) anchors the video diffusion backbone to the 3D geometry, with first-frame latent anchoring for temporal coherence.}}{13}{figure.caption.21}\protected@file@percent }
\newlabel{fig:artiflow}{{5}{13}{\textbf {ArtiFlow.} The composited 3D scene is rendered into a multi-view keyframe stream providing RGB, depth, and edge signals. A dual-branch control injection (depth + edge) anchors the video diffusion backbone to the 3D geometry, with first-frame latent anchoring for temporal coherence}{figure.caption.21}{}}
\@writefile{loa}{\contentsline {algorithm}{\numberline {1}{\ignorespaces Canvas3D Pipeline}}{13}{algorithm.1}\protected@file@percent }
\newlabel{alg:canvas3d}{{1}{13}{Canvas3D Pipeline}{algorithm.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Qualitative comparison on three representative paintings.} Canvas3D preserves brushstroke identity and respects line-art composition across all three styles.}}{13}{figure.caption.28}\protected@file@percent }
\newlabel{fig:qual_main}{{6}{13}{\textbf {Qualitative comparison on three representative paintings.} Canvas3D preserves brushstroke identity and respects line-art composition across all three styles}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Pipeline visualization.} Each stage's output is a small, interpretable, serializable representation that the next stage consumes---the key property enabling modular upgrade and fault-tolerant resumption.}}{13}{figure.caption.36}\protected@file@percent }
\newlabel{fig:qual_pipeline}{{7}{13}{\textbf {Pipeline visualization.} Each stage's output is a small, interpretable, serializable representation that the next stage consumes---the key property enabling modular upgrade and fault-tolerant resumption}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Novel-view exploration.} Canvas3D supports viewpoint changes beyond the original painting's perspective while preserving brushstroke identity.}}{13}{figure.caption.37}\protected@file@percent }
\newlabel{fig:qual_novelview}{{8}{13}{\textbf {Novel-view exploration.} Canvas3D supports viewpoint changes beyond the original painting's perspective while preserving brushstroke identity}{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Depth-conditioned inpainting.} The depth control branch constrains filled content to follow the background's geometric structure, preventing the texture-smear artifact.}}{13}{figure.caption.38}\protected@file@percent }
\newlabel{fig:qual_inpainting}{{9}{13}{\textbf {Depth-conditioned inpainting.} The depth control branch constrains filled content to follow the background's geometric structure, preventing the texture-smear artifact}{figure.caption.38}{}}
