\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Canvas3D overview.} A modular pipeline that factors painting animation into four independently optimized specialists: \emph  {PaintParse} (perceptual grouping and depth-ordered layering), \emph  {MonoSplat} (per-object 3D lifting into a reusable library), \emph  {SketchComp} (line-art-guided scene composition with depth-aware inpainting), and \emph  {ArtiFlow} (geometry-grounded video synthesis with dual control signals). A dashed feedback loop re-composes the scene when per-object motion verification fails.}}{15}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{15}{\textbf {Canvas3D overview.} A modular pipeline that factors painting animation into four independently optimized specialists: \emph {PaintParse} (perceptual grouping and depth-ordered layering), \emph {MonoSplat} (per-object 3D lifting into a reusable library), \emph {SketchComp} (line-art-guided scene composition with depth-aware inpainting), and \emph {ArtiFlow} (geometry-grounded video synthesis with dual control signals). A dashed feedback loop re-composes the scene when per-object motion verification fails}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {PaintParse.} A segmentation backbone and a monocular depth estimator run in parallel; art-domain adaptation injects painting-specific statistics into the backbone, and a percentile-based layer assignment fuses masks with depth into a depth-ordered output.}}{16}{figure.caption.8}\protected@file@percent }
\newlabel{fig:paintparse}{{2}{16}{\textbf {PaintParse.} A segmentation backbone and a monocular depth estimator run in parallel; art-domain adaptation injects painting-specific statistics into the backbone, and a percentile-based layer assignment fuses masks with depth into a depth-ordered output}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {MonoSplat.} Each foreground crop is lifted into a canonical 3D representation by a feed-forward predictor; the PaintParse depth cue is used to recover metric scale, and the resulting objects are stored in a reusable, retrievable library.}}{16}{figure.caption.12}\protected@file@percent }
\newlabel{fig:monosplat}{{3}{16}{\textbf {MonoSplat.} Each foreground crop is lifted into a canonical 3D representation by a feed-forward predictor; the PaintParse depth cue is used to recover metric scale, and the resulting objects are stored in a reusable, retrievable library}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {SketchComp.} Hand-drawn contours are extracted and matched to rendered 3D silhouettes via a rigid registration that jointly optimizes region IoU and boundary Chamfer distance. After depth-sorted scene assembly, disocclusion gaps are detected and filled by a depth-conditioned inpainting diffusion module that respects the background's geometric structure.}}{16}{figure.caption.16}\protected@file@percent }
\newlabel{fig:sketchcomp}{{4}{16}{\textbf {SketchComp.} Hand-drawn contours are extracted and matched to rendered 3D silhouettes via a rigid registration that jointly optimizes region IoU and boundary Chamfer distance. After depth-sorted scene assembly, disocclusion gaps are detected and filled by a depth-conditioned inpainting diffusion module that respects the background's geometric structure}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {ArtiFlow.} The composited 3D scene is rendered into a multi-view keyframe stream providing RGB, depth, and edge signals. A dual-branch control injection (depth + edge) anchors the video diffusion backbone to the 3D geometry, with first-frame latent anchoring for temporal coherence.}}{16}{figure.caption.21}\protected@file@percent }
\newlabel{fig:artiflow}{{5}{16}{\textbf {ArtiFlow.} The composited 3D scene is rendered into a multi-view keyframe stream providing RGB, depth, and edge signals. A dual-branch control injection (depth + edge) anchors the video diffusion backbone to the 3D geometry, with first-frame latent anchoring for temporal coherence}{figure.caption.21}{}}
\@writefile{loa}{\contentsline {algorithm}{\numberline {1}{\ignorespaces Canvas3D Pipeline}}{16}{algorithm.1}\protected@file@percent }
\newlabel{alg:canvas3d}{{1}{16}{Canvas3D Pipeline}{algorithm.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {SceneGraph3D.} Foreground objects and the background become graph nodes carrying geometric and semantic attributes; typed, quantified spatial relations---2D projection, depth ordering, topological, and physical-support---become edges. The graph is editable and serializable, and is the handshake representation consumed by ViewCtrl and SpatialFlow.}}{17}{figure.caption.26}\protected@file@percent }
\newlabel{fig:scenegraph3d}{{6}{17}{\textbf {SceneGraph3D.} Foreground objects and the background become graph nodes carrying geometric and semantic attributes; typed, quantified spatial relations---2D projection, depth ordering, topological, and physical-support---become edges. The graph is editable and serializable, and is the handshake representation consumed by ViewCtrl and SpatialFlow}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {ViewCtrl.} A user-specified trajectory (manual, orbit, dolly, crane, or auto-orbit) drives multi-view rendering of the composited scene, producing RGB, depth, and edge keyframes plus per-node visibility sets $\mathcal  {V}_t$ that determine which scene-graph nodes contribute to SpatialFlow's per-frame relation embedding.}}{17}{figure.caption.30}\protected@file@percent }
\newlabel{fig:viewctrl}{{7}{17}{\textbf {ViewCtrl.} A user-specified trajectory (manual, orbit, dolly, crane, or auto-orbit) drives multi-view rendering of the composited scene, producing RGB, depth, and edge keyframes plus per-node visibility sets $\mathcal {V}_t$ that determine which scene-graph nodes contribute to SpatialFlow's per-frame relation embedding}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {SpatialFlow.} The edited scene graph is encoded by a GNN and pooled per-frame over the visible node set into a relation context $\mathbf  {c}_t^\text  {rel}$, which is injected as a third control signal alongside depth and edge into the video diffusion backbone. A relation-consistency verification loop re-prompts when generated frames violate the edited graph.}}{17}{figure.caption.35}\protected@file@percent }
\newlabel{fig:spatialflow}{{8}{17}{\textbf {SpatialFlow.} The edited scene graph is encoded by a GNN and pooled per-frame over the visible node set into a relation context $\mathbf {c}_t^\text {rel}$, which is injected as a third control signal alongside depth and edge into the video diffusion backbone. A relation-consistency verification loop re-prompts when generated frames violate the edited graph}{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Qualitative comparison on three representative paintings.} Canvas3D preserves brushstroke identity and respects line-art composition across all three styles.}}{17}{figure.caption.42}\protected@file@percent }
\newlabel{fig:qual_main}{{9}{17}{\textbf {Qualitative comparison on three representative paintings.} Canvas3D preserves brushstroke identity and respects line-art composition across all three styles}{figure.caption.42}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Pipeline visualization.} Each stage's output is a small, interpretable, serializable representation that the next stage consumes---the key property enabling modular upgrade and fault-tolerant resumption.}}{17}{figure.caption.53}\protected@file@percent }
\newlabel{fig:qual_pipeline}{{10}{17}{\textbf {Pipeline visualization.} Each stage's output is a small, interpretable, serializable representation that the next stage consumes---the key property enabling modular upgrade and fault-tolerant resumption}{figure.caption.53}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Novel-view exploration.} Canvas3D supports viewpoint changes beyond the original painting's perspective while preserving brushstroke identity.}}{17}{figure.caption.54}\protected@file@percent }
\newlabel{fig:qual_novelview}{{11}{17}{\textbf {Novel-view exploration.} Canvas3D supports viewpoint changes beyond the original painting's perspective while preserving brushstroke identity}{figure.caption.54}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {Depth-conditioned inpainting.} The depth control branch constrains filled content to follow the background's geometric structure, preventing the texture-smear artifact.}}{17}{figure.caption.55}\protected@file@percent }
\newlabel{fig:qual_inpainting}{{12}{17}{\textbf {Depth-conditioned inpainting.} The depth control branch constrains filled content to follow the background's geometric structure, preventing the texture-smear artifact}{figure.caption.55}{}}
\gdef \@abspage@last{17}
